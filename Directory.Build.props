<Project>

  <!--
    빌드 산출물을 저장소 루트의 artifacts/ 한 곳으로 모은다.

    ★ 편의가 아니라 필수다.
      core/ 는 Unity 가 로컬 UPM 패키지(file:../../core)로 참조한다.
      기본 설정이면 dotnet build 가 core/bin/... 에 DomoNinja.Core.dll 을 남기는데,
      Unity 는 패키지 폴더 안의 DLL 을 플러그인으로 가져간다.
      그러면 asmdef 로 컴파일한 어셈블리와 이름이 같은 DLL 이 둘 다 로드되어
      중복 어셈블리 충돌이 난다.

      출력 위치를 패키지 밖으로 빼서 이 충돌을 구조적으로 없앤다.
  -->

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 재현 가능한 빌드. 같은 소스 -> 같은 어셈블리 (05 §2.4 결정론과 같은 방향) -->
    <Deterministic>true</Deterministic>
    <LangVersion>9.0</LangVersion>
    <!--
      C# 9 로 고정하는 이유: core 는 Unity 6 이 컴파일한다.
      dotnet 쪽에서만 최신 문법이 통과하면 Unity 에서 깨지는데,
      그 사실을 D+5 Unity 통합 시점에야 알게 된다. 지금 막는다.
    -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
