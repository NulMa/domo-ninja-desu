<Project Sdk="Microsoft.NET.Sdk">

  <!--
    순수 C# 전투 코어. UnityEngine 을 참조하지 않는다.

    netstandard2.1 로 고정한 이유:
      Unity 6 의 API Compatibility Level 이 .NET Standard 2.1 이다.
      여기서 빌드가 통과하면 Unity 에서도 컴파일된다는 뜻이 된다.
      net9.0 으로 두면 dotnet 에서만 되고 Unity 에서 깨지는 코드가 통과해버린다.

    ⚠️ 이 프로젝트는 두 곳에서 컴파일된다 — dotnet(sim/tests) 과 Unity(asmdef).
       그래서 의존 방향 가드도 두 겹이다:
         ① DomoNinja.Core.asmdef 의 noEngineReferences  -> Unity 쪽
         ② CI 의 UnityEngine grep 검사                  -> dotnet 쪽
       asmdef 는 dotnet 빌드에 관여하지 않으므로 ②를 뺄 수 없다. (19 §2.3)
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DomoNinja.Core</AssemblyName>
    <RootNamespace>DomoNinja.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ⚠️ 버전을 13.0.2 로 고정한 것은 임의 선택이 아니다.
         Unity 의 com.unity.nuget.newtonsoft-json 3.2.2 가 내장한 DLL 이 정확히 13.0.2 다
         (FileVersion 확인). 여기서 다른 버전을 쓰면 같은 JSON 을 두 런타임이 다르게
         해석할 여지가 생기고, 그건 "sim 결과 == 게임 결과"라는 전제를 흔든다.
         Unity 패키지 버전을 올릴 때 이 줄도 같이 올린다.

      ★ 이 참조가 없던 동안 위험한 비대칭이 있었다 —
        Unity 는 Newtonsoft 를 auto-referenced DLL 로 이미 보고 있었으므로
        JSON 파싱 코드를 짜면 Unity 에서는 컴파일되고 dotnet build 에서만 깨진다.
        csproj 주석에 적어둔 가드는 그 반대 방향(dotnet OK / Unity 실패)만 막고 있었다.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity 가 이 폴더를 UPM 패키지로 읽는다. dotnet 컴파일 대상은 아니다. -->
    <None Include="package.json" />
    <None Include="DomoNinja.Core.asmdef" />
  </ItemGroup>

</Project>
